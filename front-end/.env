# HealthyTrack Mobile - Configuración para Expo
# NOTA: Esta aplicación ya NO usa Vite, ahora es React Native con Expo
# La configuración de API se realiza en app.json en la sección "extra"

# Referencia de configuración anterior (no se usa):
# VITE_API_URL=http://localhost:8080/api

# Para configurar la URL del API, edita app.json y actualiza:
# "extra": {
#   "apiUrl": "http://TU_IP:8080/api"
# }
